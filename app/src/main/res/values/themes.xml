<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The platform theme exists only to paint the window before Compose takes over. Its
      background matches StillColors.Background so a cold start does not flash; the real theme
      lives in ui/theme/Theme.kt. @color/window_background is light here and dark in
      values-night, which is what the platform resolves for the SYSTEM default.
    -->
    <style name="Theme.Still" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
    </style>
</resources>
